{
  "buildCommand": "cp package.web.json package.json && pnpm install && pnpm build",
  "outputDirectory": "dist",
  "installCommand": "cp package.web.json package.json && pnpm install",
  "framework": null,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://your-api-domain.com/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
